{
  "name": "@torihub/ui",
  "version": "1.0.0",
  "private": true,
  "main": "./index.tsx",
  "exports": {
    ".": {
      "types": "./index.tsx",
      "default": "./index.tsx"
    },
    "./components/card": {
      "types": "./components/Card.tsx",
      "default": "./components/Card.tsx"
    },
    "./components/card-header": {
      "types": "./components/CardHeader.tsx",
      "default": "./components/CardHeader.tsx"
    },
    "./components/card-title": {
      "types": "./components/CardTitle.tsx",
      "default": "./components/CardTitle.tsx"
    },
    "./components/card-description": {
      "types": "./components/CardDescription.tsx",
      "default": "./components/CardDescription.tsx"
    },
    "./components/card-content": {
      "types": "./components/CardContent.tsx",
      "default": "./components/CardContent.tsx"
    },
    "./components/card-footer": {
      "types": "./components/CardFooter.tsx",
      "default": "./components/CardFooter.tsx"
    },
    "./components/*": {
      "types": "./components/*.tsx",
      "default": "./components/*.tsx"
    },
    "./utils": {
      "types": "./utils.ts",
      "default": "./utils.ts"
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}